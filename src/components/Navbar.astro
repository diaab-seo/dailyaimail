<!-- Search Modal — position:fixed, JS controls display, never affects page layout -->
<div
  id="search-modal"
  class="search-modal"
  aria-modal="true"
  role="dialog"
  aria-label="Search Daily AI Mail"
>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-container">
    <div id="search"></div>
  </div>
</div>

<!-- Pagefind UI assets -->
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script>
  // ── Auth state → avatar button + mobile nav ─────────────────────────────────
  (async () => {
    try {
      const res = await fetch("/api/me");
      const data = (await res.json()) as { user?: any };
      const user = data.user;

      const avatarBtn = document.getElementById("avatar-btn");
      const avatarInitials = document.getElementById("avatar-initials");
      const avatarIcon = document.getElementById("avatar-icon");
      const avatarGuest = document.getElementById("avatar-guest");
      const avatarUser = document.getElementById("avatar-user");
      const avatarName = document.getElementById("avatar-display-name");

      // Mobile
      const mobileSignin = document.getElementById("mobile-signin-item");
      const mobileRegister = document.getElementById("mobile-register-item");
      const mobileLogout = document.getElementById("mobile-logout-item");

      if (user && user.displayName) {
        // ── Logged in ──────────────────────────────────────────────────────────
        const initials =
          user.avatarInitials ||
          user.displayName
            .split(" ")
            .map((n: string) => n[0])
            .join("")
            .toUpperCase()
            .slice(0, 2);
        if (avatarInitials) avatarInitials.textContent = initials;
        if (avatarBtn) avatarBtn.classList.add("is-logged-in");
        if (avatarBtn) avatarBtn.setAttribute("aria-label", user.displayName);
        if (avatarGuest) avatarGuest.style.display = "none";
        if (avatarUser) avatarUser.style.display = "";
        if (avatarName) avatarName.textContent = user.displayName;
        // Mobile
        if (mobileSignin) mobileSignin.style.display = "none";
        if (mobileRegister) mobileRegister.style.display = "none";
        if (mobileLogout) mobileLogout.style.display = "";
      } else {
        // ── Logged out ─────────────────────────────────────────────────────────
        if (avatarGuest) avatarGuest.style.display = "";
        if (avatarUser) avatarUser.style.display = "none";
        // Mobile already shows sign in by default
      }
    } catch {
      // Silently fail
    }
  })();

  // ── Avatar dropdown toggle ──────────────────────────────────────────────────
  const avatarBtn = document.getElementById("avatar-btn");
  const avatarDropdown = document.getElementById("avatar-dropdown");

  if (avatarBtn && avatarDropdown) {
    avatarBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !avatarDropdown.hidden;
      avatarDropdown.hidden = isOpen;
      avatarBtn.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", (e) => {
      if (
        !avatarDropdown.hidden &&
        !avatarDropdown.contains(e.target as Node)
      ) {
        avatarDropdown.hidden = true;
        avatarBtn.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !avatarDropdown.hidden) {
        avatarDropdown.hidden = true;
        avatarBtn.setAttribute("aria-expanded", "false");
        avatarBtn.focus();
      }
    });
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Force modal hidden on init (JS-controlled, no CSS [hidden] attribute) ──
    const searchModal = document.getElementById(
      "search-modal",
    ) as HTMLElement | null;
    if (searchModal) searchModal.style.display = "none";

    // ── Hamburger ──────────────────────────────────────────────────────────────
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const mainNav = document.getElementById("main-nav");

    if (hamburgerBtn && mainNav) {
      hamburgerBtn.addEventListener("click", () => {
        const isOpen = mainNav.hasAttribute("data-open");
        mainNav.toggleAttribute("data-open");
        hamburgerBtn.setAttribute("aria-expanded", String(!isOpen));
        hamburgerBtn.setAttribute(
          "aria-label",
          isOpen ? "Open menu" : "Close menu",
        );
      });
    }

    // ── Newsletter modal ────────────────────────────────────────────────────────
    function openNewsletterModal() {
      const nlOverlay = document.getElementById("nl-modal-overlay");
      if (nlOverlay) {
        nlOverlay.hidden = false;
        document.body.style.overflow = "hidden";
      }
    }

    const navSubscribeBtn = document.getElementById("nav-subscribe-btn");
    if (navSubscribeBtn) {
      navSubscribeBtn.addEventListener("click", openNewsletterModal);
    }

    const mobileSubscribeLink = document.getElementById(
      "mobile-subscribe-link",
    );
    if (mobileSubscribeLink) {
      mobileSubscribeLink.addEventListener("click", (e) => {
        e.preventDefault();
        // Close the mobile menu
        if (mainNav) mainNav.removeAttribute("data-open");
        openNewsletterModal();
      });
    }

    // ── Search modal ───────────────────────────────────────────────────────────
    const searchOpenBtn = document.getElementById("search-open-btn");
    const searchBackdrop = document.getElementById("search-backdrop");
    const searchEl = document.getElementById("search");

    if (!searchOpenBtn || !searchModal || !searchEl) return;

    let pagefindInitialised = false;

    function openSearch() {
      searchModal.style.display = "flex";
      document.body.style.overflow = "hidden";

      if (pagefindInitialised && searchModal) {
        (searchModal.querySelector("input[type=text]") as HTMLElement)?.focus();
        return;
      }

      const isDev =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1";

      if (isDev) {
        searchEl.innerHTML = `<div style="padding:32px 24px;color:#8a95a8;font-size:14px;font-family:var(--font-mono);text-align:center;line-height:1.9;"><div style="font-size:32px;margin-bottom:12px;">🔍</div>Search requires a production build.<br/>Run <code style="color:#e8b84b;background:rgba(232,184,75,0.1);padding:2px 8px;border-radius:4px;">npm run build &amp;&amp; npm run preview</code><br/>to test search locally.</div>`;
        pagefindInitialised = true;
        return;
      }

      const PagefindUI = (window as Window & {
        PagefindUI?: new (options: {
          element: string;
          showSubResults: boolean;
          showImages: boolean;
          resetStyles: boolean;
        }) => unknown;
      }).PagefindUI;

      if (!PagefindUI) {
        console.warn("[Search] Pagefind UI script was not found at /pagefind/pagefind-ui.js");
        searchEl.innerHTML = `<div style="padding:24px;color:#8a95a8;text-align:center;font-family:var(--font-mono);font-size:14px;">Search index not available.</div>`;
        return;
      }

      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
      });
      pagefindInitialised = true;
      setTimeout(() => {
        if (searchModal)
          (
            searchModal.querySelector("input[type=text]") as HTMLElement
          )?.focus();
      }, 50);
    }

    function closeSearch() {
      searchModal.style.display = "none";
      document.body.style.overflow = "";
    }

    searchOpenBtn.addEventListener("click", openSearch);
    searchBackdrop?.addEventListener("click", closeSearch);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeSearch();
      if (e.key === "k" && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        openSearch();
      }
    });
  });
</script>

<style>
  /* ── Navbar shell ─────────────────────────── */
  .navbar {
    background: var(--color-base);
    color: var(--color-text-primary);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
  }
  .navbar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ── Logo ─────────────────────────────────── */
  .navbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .navbar-logo .logo {
    display: block;
    height: 56px;
    width: auto;
  }

  /* ── Desktop nav links ───────────────────── */
  .desktop-nav {
    display: flex;
    list-style: none;
    gap: 4px;
    margin: 0;
    padding: 0;
    flex: 1;
    justify-content: center;
  }
  .desktop-nav > li {
    position: relative;
  }
  .desktop-nav > li > a {
    display: block;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--color-text-primary);
    transition: var(--transition);
    white-space: nowrap;
  }
  .desktop-nav > li > a:hover {
    color: var(--color-gold);
    background: rgba(255, 255, 255, 0.05);
  }

  /* ── Dropdown ─────────────────────────────── */
  .has-dropdown .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 6px;
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    list-style: none;
    min-width: 188px;
    z-index: 200;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    display: block;
  }
  .dropdown li a {
    display: block;
    font-size: 13.5px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    transition: var(--transition);
  }
  .dropdown li a:hover {
    background: rgba(245, 197, 24, 0.08);
    color: var(--color-gold);
  }

  /* ── User menu items in About dropdown ──────── */
  .nav-hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 4px 0;
  }
  .nav-username {
    display: block;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--color-gold);
    padding: 6px 14px 4px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .nav-signout-btn {
    display: block;
    width: 100%;
    text-align: left;
    font-size: 13.5px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: var(--transition);
  }
  .nav-signout-btn:hover {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-danger);
  }
  .nav-signin-link {
    display: block;
    font-size: 13.5px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    color: var(--color-gold);
    transition: var(--transition);
  }
  .nav-signin-link:hover {
    background: rgba(245, 197, 24, 0.08);
  }

  /* ── Nav actions ─────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ── Icon buttons ────────────────────────── */
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: var(--transition);
  }
  .icon-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-gold);
    background: rgba(245, 197, 24, 0.05);
  }

  /* ── Hide on mobile ──────────────────────── */
  @media (max-width: 900px) {
    .hide-mobile {
      display: none !important;
    }
  }

  /* ── Hamburger ───────────────────────────── */
  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid rgba(244, 240, 232, 0.12);
    border-radius: 8px;
    color: rgba(244, 240, 232, 0.8);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .hamburger:hover {
    color: #f4f0e8;
    border-color: rgba(232, 184, 75, 0.4);
  }

  /* ── Avatar Dropdown ──────────────────────── */
  .avatar-wrap {
    position: relative;
  }
  .avatar-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    cursor: pointer;
  }
  .avatar-btn.is-logged-in {
    background: #2a3441;
  }
  .avatar-initials {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .is-logged-in #avatar-icon {
    display: none;
  }
  .avatar-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 8px;
    min-width: 200px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    z-index: 200;
  }
  .avatar-item {
    display: block;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--color-text-primary);
    border-radius: 4px;
    text-decoration: none;
  }
  .avatar-item:hover {
    background: rgba(232, 184, 75, 0.1);
    color: var(--color-gold);
  }
  .avatar-item--btn {
    width: 100%;
    text-align: left;
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
  }
  .avatar-display-name {
    padding: 8px 14px 4px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--color-gold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .avatar-rule {
    border-top: 1px solid var(--color-border);
    margin: 4px 0;
  }

  /* ── Mobile nav ───────────────────────────── */
  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 8px var(--gutter) 16px;
    margin: 0;
    list-style: none;
    background: #0a1020;
    border-top: 1px solid rgba(232, 184, 75, 0.1);
  }
  .mobile-nav li a {
    display: block;
    padding: 13px 0;
    font-size: 15px;
    font-weight: 500;
    color: rgba(244, 240, 232, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: color 0.15s;
  }
  .mobile-nav li a:hover {
    color: #e8b84b;
  }

  /* ── Open state ───────────────────────────── */
  nav[data-open] .mobile-nav {
    display: flex;
  }
  nav[data-open] .hamburger {
    color: #e8b84b;
    border-color: rgba(232, 184, 75, 0.4);
  }

