---
export interface Props {
  page: any;
}
const { page } = Astro.props;
---
<nav aria-label="Pagination" class="pagination-nav">
  {page.url.prev ? (
    <a href={page.url.prev} class="action-btn prev-btn">← Previous</a>
  ) : (
    <span class="action-btn prev-btn disabled">← Previous</span>
  )}

  <span class="page-info">Page {page.currentPage} of {page.lastPage}</span>

  {page.url.next ? (
    <a href={page.url.next} class="action-btn next-btn">Next →</a>
  ) : (
    <span class="action-btn next-btn disabled">Next →</span>
  )}
</nav>

<style>
  .pagination-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 40px 0;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 14px;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition);
  }
  .action-btn:hover:not(.disabled) {
    color: var(--color-gold);
    border-color: var(--color-gold);
    background: rgba(245, 197, 24, 0.05);
  }
  .disabled {
    opacity: 0.35;
    cursor: not-allowed;
    color: var(--color-text-hint);
  }
  .page-info {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-gold); /* active page indicator color */
  }
</style>
