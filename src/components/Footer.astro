<style>
  .footer {
    background: var(--color-base);
    color: var(--color-text-secondary);
    padding: 60px var(--gutter) 32px;
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 48px;
    margin-bottom: 60px;
  }
  .footer-logo {
    display: block;
    margin-bottom: 24px;
  }
  .footer-logo .logo {
    display: block;
    height: 64px;
    width: auto;
  }

  .tagline {
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }
  .links-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .footer-col-heading {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--color-text-primary);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-col ul a {
    color: var(--color-text-secondary);
    font-size: 14px;
    transition: var(--transition);
  }
  .footer-col ul a:hover {
    color: var(--color-gold);
  }
  .all-topics-item {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }
  .all-topics-item a {
    color: var(--color-gold) !important;
    font-weight: 600;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
    color: var(--color-text-hint);
  }
  .legal-links a {
    color: var(--color-text-hint);
    transition: var(--transition);
  }
  .legal-links a:hover {
    color: var(--color-gold);
  }
  .sep {
    margin: 0 8px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
