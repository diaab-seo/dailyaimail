---
interface Props {
  caption: string;
  headers: string[];
  rows: Array<Array<string | number>>;
  disclosure?: string;
}

const {
  caption,
  headers,
  rows,
  disclosure = 'Data shown is compiled from the cited sources in this report.',
} = Astro.props;
const tableId = `stat-table-${crypto.randomUUID()}`;
---

<div class="stat-table-wrap">
  <table class="stat-table" id={tableId}>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {
          headers.map((header, index) => (
            <th
              scope="col"
              data-sort={index}
              tabindex="0"
              aria-sort="none"
            >
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) => <td>{String(cell)}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="stat-disclosure"><em>{disclosure}</em></p>

<script is:inline define:vars={{ tableId }}>
  const table = document.getElementById(tableId);
  if (table) {
    const headers = Array.from(table.querySelectorAll('th[data-sort]'));
    const tbody = table.querySelector('tbody');
    const parseValue = (value) => {
      const cleaned = String(value).replace(/[%,$M+B]/g, '').replace(/,/g, '').trim();
      const parsed = Number.parseFloat(cleaned);
      return Number.isNaN(parsed) ? String(value).toLowerCase() : parsed;
    };

    let activeColumn = -1;
    let direction = 'asc';

    const sortBy = (columnIndex) => {
      if (!tbody) return;
      direction = activeColumn === columnIndex && direction === 'asc' ? 'desc' : 'asc';
      activeColumn = columnIndex;

      const rows = Array.from(tbody.querySelectorAll('tr'));
      rows.sort((a, b) => {
        const aValue = parseValue(a.children[columnIndex]?.textContent ?? '');
        const bValue = parseValue(b.children[columnIndex]?.textContent ?? '');
        if (aValue < bValue) return direction === 'asc' ? -1 : 1;
        if (aValue > bValue) return direction === 'asc' ? 1 : -1;
        return 0;
      });

      tbody.append(...rows);

      headers.forEach((header, index) => {
        header.classList.remove('asc', 'desc');
        header.setAttribute('aria-sort', 'none');
        if (index === columnIndex) {
          header.classList.add(direction);
          header.setAttribute('aria-sort', direction === 'asc' ? 'ascending' : 'descending');
        }
      });
    };

    headers.forEach((header, index) => {
      header.addEventListener('click', () => sortBy(index));
      header.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          sortBy(index);
        }
      });
    });
  }
</script>
