---
// NewsletterBanner.astro
// Full-width newsletter banner — used between content sections on the homepage.
// Posts directly to Kit's endpoint (no Kit JS required).
---

<section class="nl-banner" aria-label="Newsletter sign-up">
  <div class="nl-banner-inner">
    <div class="nl-banner-text">
      <h2 class="nl-banner-heading">AI News for People Who Build With It</h2>
      <p class="nl-banner-sub">
        Researchers, engineers, and founders read Daily AI Mail to stay sharp.
        Join them.
      </p>
    </div>
    <form
      action="https://app.kit.com/forms/9241006/subscriptions"
      method="post"
      class="nl-banner-form"
      target="_blank"
    >
      <input type="hidden" name="utf8" value="✓" />
      <div class="nl-banner-row">
        <input
          type="email"
          name="email_address"
          class="nl-banner-input"
          placeholder="Email Address"
          required
        />
        <button type="submit" class="nl-banner-btn">Subscribe</button>
      </div>
      <p class="nl-banner-disclaimer">
        We won't send you spam. Unsubscribe at any time.
      </p>
    </form>
  </div>
</section>

<style>
  .nl-banner {
    padding: 56px var(--gutter, 24px);
    background: rgb(10, 14, 26);
    margin: 0;
  }
  .nl-banner-inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .nl-banner-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: rgb(240, 244, 250);
    margin-bottom: 12px;
    line-height: 1.25;
  }
  .nl-banner-sub {
    font-size: 1rem;
    color: rgb(138, 154, 181);
    margin-bottom: 28px;
    line-height: 1.6;
  }
  .nl-banner-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .nl-banner-row {
    display: flex;
    width: 100%;
    max-width: 520px;
    gap: 10px;
  }
  .nl-banner-input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid rgb(30, 42, 58) !important;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06) !important;
    color: rgb(240, 244, 250) !important;
    font-size: 0.9375rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  .nl-banner-input::placeholder {
    color: rgb(90, 106, 130) !important;
  }
  .nl-banner-input:focus {
    border-color: rgb(245, 197, 24) !important;
  }
  .nl-banner-btn {
    padding: 12px 24px;
    background: rgb(245, 197, 24) !important;
    color: rgb(8, 13, 26) !important;
    border: none !important;
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .nl-banner-btn:hover {
    background: rgb(220, 175, 15) !important;
  }
  .nl-banner-disclaimer {
    font-size: 0.8125rem;
    color: rgb(90, 106, 130);
    margin: 0;
  }

  @media (max-width: 480px) {
    .nl-banner-row {
      flex-direction: column;
    }
    .nl-banner-btn {
      width: 100%;
    }
  }
</style>
