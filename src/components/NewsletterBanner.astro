---
import NewsletterForm from "./NewsletterForm.astro";
// NewsletterBanner.astro
// Full-width newsletter banner — used between content sections on the homepage.
---

<section class="nl-banner" aria-label="Newsletter sign-up">
  <div class="nl-banner-inner">
    <div class="nl-banner-text">
      <h2 class="nl-banner-heading">Subscribe To Our Daily AI Newsletter</h2>
      <p class="nl-banner-sub">
        Get the latest AI news and insights delivered straight to your inbox.
        Join thousands of subscribers who rely on Daily AI Mail to stay ahead in
        the fast-moving world of artificial intelligence.
      </p>
    </div>
    <div class="nl-banner-form-container">
      <NewsletterForm />
    </div>
  </div>
</section>

<style>
  .nl-banner {
    padding: 56px var(--gutter, 24px);
    background: rgb(10, 14, 26);
    margin: 0;
  }
  .nl-banner-inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .nl-banner-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: rgb(240, 244, 250);
    margin-bottom: 12px;
    line-height: 1.25;
  }
  .nl-banner-sub {
    font-size: 1rem;
    color: rgb(138, 154, 181);
    margin-bottom: 28px;
    line-height: 1.6;
  }
  .nl-banner-form-container {
    max-width: 520px;
    margin: 0 auto;
  }
</style>
