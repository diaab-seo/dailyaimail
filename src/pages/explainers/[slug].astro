---
// src/pages/explainers/[slug].astro
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { buildExplainerTermSchema } from "../../lib/explainers-schema";
import Breadcrumb from "../../components/Breadcrumb.astro";

export async function getStaticPaths() {
    const terms = await getCollection("explainers");
    return terms.map(t => ({
        params: { slug: t.data.slug },
        props: { entry: t },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const CATEGORY_LABELS: Record<string, string> = {
    "foundation-models":  "Foundation Models",
    "training":           "Training",
    "inference":          "Inference",
    "agents":             "Agents",
    "safety-alignment":   "Safety & Alignment",
    "architecture":       "Architecture",
    "data":               "Data",
    "applications":       "Applications",
};

const schema = buildExplainerTermSchema({
    slug:           d.slug,
    term:           d.term,
    abbreviation:   d.abbreviation,
    category:       d.category,
    definition:     d.definition,
    dateAdded:      d.dateAdded,
    lastUpdated:    d.lastUpdated,
    relatedTerms:   d.relatedTerms,
    seoTitle:       d.seoTitle,
    seoDescription: d.seoDescription,
});

const pageTitle = d.seoTitle ?? `${d.term}${d.abbreviation ? ` (${d.abbreviation})` : ''} — AI Explainer`;
const pageDesc  = d.seoDescription ?? d.definition;
const ogImage   = d.featuredImage
    ? `https://dailyaimail.news${d.featuredImage.startsWith("/") ? "" : "/"}${d.featuredImage}`
    : undefined;

// Related term collection entries for cross-links
const allTerms     = await getCollection("explainers");
const relatedTerms = (d.relatedTerms ?? [])
    .map(slug => allTerms.find(t => t.data.slug === slug)?.data)
    .filter(Boolean);

const SECTIONS = [
    { id: "definition",      label: "Definition" },
    { id: "why-it-matters",  label: "Why It Matters" },
    { id: "how-it-works",    label: "How It Works" },
    { id: "applications",    label: "Applications" },
    { id: "limitations",     label: "Limitations" },
    { id: "related-terms",   label: "Related Terms" },
    { id: "further-reading", label: "Further Reading" },
];

const formatDate = (isoStr: string) => {
    return new Date(isoStr).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
    });
};

const dateAddedStr = formatDate(d.dateAdded);
const lastUpdatedStr = formatDate(d.lastUpdated ?? d.dateAdded);
---

<Layout title={pageTitle} description={pageDesc} metaTitle={pageTitle} ogImage={ogImage}>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
        slot="head"
    />

    <Breadcrumb items={[
        { label: "Home", href: "/" },
        { label: "Explainers", href: "/explainers" },
        { label: d.term }
    ]} />

    <main class="term-page">
        <!-- ── Hero ── -->
        <header class="term-hero">
            <div class="term-inner">

                <div class="term-meta">
                    <span class="cat-badge">{CATEGORY_LABELS[d.category] ?? d.category}</span>
                    <time class="updated-date" datetime={d.dateAdded}>
                        Added {dateAddedStr}
                    </time>
                    <time class="updated-date" datetime={d.lastUpdated ?? d.dateAdded}>
                        Updated {lastUpdatedStr}
                    </time>

                    <button id="copy-markdown-btn" class="term-meta-btn" title="Copy article as Markdown">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        <span>Copy as Markdown</span>
                    </button>

                    <div class="share-wrapper">
                        <button id="share-toggle" class="term-meta-btn" aria-expanded="false" aria-controls="share-popover">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                            <span>Share</span>
                            <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>

                        <div id="share-popover" class="share-popover" hidden>
                            <button class="share-item" id="copy-link-btn">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                Copy link
                            </button>
                            <a class="share-item" id="share-x" target="_blank" rel="noopener noreferrer">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                                X / Twitter
                            </a>
                            <a class="share-item" id="share-li" target="_blank" rel="noopener noreferrer">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                                LinkedIn
                            </a>
                        </div>
                    </div>
                </div>

                <h1 class="term-title">
                    {d.term}
                    {d.abbreviation && <span class="term-abbr-hero">({d.abbreviation})</span>}
                </h1>

                <p class="term-definition">{d.definition}</p>

                <!-- Section jump bar -->
                <nav class="jump-bar" aria-label="Jump to section">
                    {SECTIONS.map(s => (
                        <a href={`#${s.id}`} class="jump-link">{s.label}</a>
                    ))}
                </nav>
            </div>
            {d.featuredImage && (
                <div class="term-featured-image-wrap">
                    <div class="term-inner">
                        <figure class="term-featured-figure">
                            <img
                                src={d.featuredImage}
                                alt={`What is ${d.term}${d.abbreviation ? ` (${d.abbreviation})` : ''}? — Daily AI Mail`}
                                class="term-featured-img"
                                width="860"
                                height="480"
                                loading="eager"
                                decoding="async"
                            />
                        </figure>
                    </div>
                </div>
            )}
        </header>

        <!-- ── Body ── -->
        <div class="term-inner term-body">
            <article class="term-content">
                <Content />
            </article>

            <!-- Related Terms sidebar card -->
            {relatedTerms.length > 0 && (
                <aside class="related-sidebar" aria-label="Related terms">
                    <h2 class="related-heading">Related Terms</h2>
                    <ul class="related-list">
                        {relatedTerms.map(rt => rt && (
                            <li>
                                <a
                                    href={`/explainers/${rt.slug}`}
                                    class="related-link"
                                    data-explainer={rt.slug}
                                >
                                    <strong>{rt.term}</strong>
                                    {rt.abbreviation && (
                                        <span class="related-abbr">({rt.abbreviation})</span>
                                    )}
                                    <span class="related-def">{rt.definition}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                    <a href="/explainers" class="back-to-hub">← All Explainers</a>
                </aside>
            )}
        </div>
    </main>

    <script is:inline>
        const copyBtn = document.getElementById("copy-markdown-btn");
        const shareBtn = document.getElementById("share-btn");

        if (copyBtn) {
            copyBtn.addEventListener("click", async () => {
                const term = document.querySelector(".term-title").innerText.trim();
                const def = document.querySelector(".term-definition").innerText.trim();
                const contentNodes = document.querySelector(".term-content").children;
                const cat = document.querySelector(".cat-badge").innerText.trim();
                const added = document.querySelector(".updated-date:nth-of-type(1)").innerText.replace("Added ", "").trim();
                const updated = document.querySelector(".updated-date:nth-of-type(2)").innerText.replace("Updated ", "").trim();

                let contentMarkdown = "";
                for (const node of contentNodes) {
                    if (node.tagName === 'H2') {
                        contentMarkdown += `## ${node.innerText.trim()}\n\n`;
                    } else {
                        contentMarkdown += `${node.innerText.trim()}\n\n`;
                    }
                }

                const url = window.location.href;
                const finalMd = [
                    `# ${term}`,
                    ``,
                    `> ${def}`,
                    ``,
                    `**Category:** ${cat}  `,
                    `**Added:** ${added}  `,
                    `**Updated:** ${updated}  `,
                    `**Source:** ${url}  `,
                    ``,
                    `---`,
                    ``,
                    contentMarkdown.trim(),
                    ``,
                    `---`,
                    `*Originally published on [Daily AI Mail](https://dailyaimail.news)*`,
                ].join('\n');

                try {
                    await navigator.clipboard.writeText(finalMd);
                    const label = copyBtn.querySelector("span");
                    const original = label.innerText;
                    label.innerText = "Copied!";
                    setTimeout(() => { label.innerText = original; }, 2000);
                } catch (e) {
                    console.error("Copy failed", e);
                }
            });
        }

        // Share functionality
        const shareToggle = document.getElementById("share-toggle");
        const sharePopover = document.getElementById("share-popover");
        const copyLinkBtn = document.getElementById("copy-link-btn");

        if (shareToggle && sharePopover) {
            const url = window.location.href;
            const title = document.title;
            const text = document.querySelector(".term-definition").innerText.trim();

            // Set social links
            const enc = encodeURIComponent;
            document.getElementById("share-x").href = `https://x.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
            document.getElementById("share-li").href = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;

            shareToggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const isHidden = sharePopover.hidden;
                sharePopover.hidden = !isHidden;
                shareToggle.setAttribute("aria-expanded", String(isHidden));
            });

            document.addEventListener("click", (e) => {
                if (!sharePopover.contains(e.target) && e.target !== shareToggle) {
                    sharePopover.hidden = true;
                    shareToggle.setAttribute("aria-expanded", "false");
                }
            });

            copyLinkBtn.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(url);
                    const original = copyLinkBtn.innerHTML;
                    copyLinkBtn.innerText = "Copied!";
                    setTimeout(() => { copyLinkBtn.innerHTML = original; }, 2000);
                } catch {}
            });
        }
    </script>
</Layout>

<style>
    .term-hero {
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        padding: 48px 0 0;
    }
    .term-inner {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 var(--gutter);
    }

    .term-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }
    .term-meta-btn {
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 5px 10px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--color-text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.12s;
        white-space: nowrap;
    }
    .term-meta-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
    }
    .term-meta-btn svg { opacity: 0.7; }
    .term-meta-btn:hover svg { opacity: 1; }
    .term-meta-btn .chevron {
        margin-left: 2px;
        opacity: 0.5;
        transition: transform 0.2s;
    }
    .term-meta-btn[aria-expanded="true"] .chevron {
        transform: rotate(180deg);
    }

    .share-wrapper {
        position: relative;
    }
    .share-popover {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: 6px;
        border-radius: 6px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        z-index: 100;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2px;
        min-width: 160px;
    }
    .share-popover[hidden] {
        display: none;
    }
    .share-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        font-size: 12px;
        font-family: var(--font-sans);
        color: var(--color-text-muted);
        border-radius: 4px;
        text-decoration: none;
        background: none;
        border: none;
        width: 100%;
        cursor: pointer;
        text-align: left;
        transition: all 0.12s;
    }
    .share-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--gold);
    }
    .share-item svg { opacity: 0.6; }
    .share-item:hover svg { opacity: 1; }

    .cat-badge {
        font-family: var(--font-mono);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 3px;
        background: color-mix(in srgb, var(--gold) 15%, transparent);
        color: var(--gold);
        border: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
    }
    .updated-date {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-text-muted);
    }

    .term-title {
        font-family: var(--font-display);
        font-size: clamp(32px, 5vw, 52px);
        font-weight: 900;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: var(--color-text);
        margin-bottom: 20px;
    }
    .term-abbr-hero {
        color: var(--gold);
        font-size: 0.65em;
        font-weight: 700;
        vertical-align: middle;
        margin-left: 8px;
    }
    .term-definition {
        font-size: 18px;
        line-height: 1.65;
        color: var(--color-text-muted);
        max-width: 680px;
        margin-bottom: 36px;
    }

    /* Jump bar */
    .jump-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        border-top: 1px solid var(--color-border);
        margin: 0 calc(-1 * var(--gutter));
        padding: 0 var(--gutter);
        overflow-x: auto;
        scrollbar-width: none;
    }
    .jump-link {
        font-size: 13px;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 12px 16px;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
        transition: all 0.12s;
    }
    .jump-link:hover {
        color: var(--gold);
        border-bottom-color: var(--gold);
    }

    /* Body layout */
    .term-body {
        padding-top: 48px;
        padding-bottom: 120px;
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 64px;
        align-items: start;
        max-width: 1100px;
    }
    .term-content {
        min-width: 0;
    }

    /* Content typography — mirrors article styles */
    .term-content :global(h2) {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 800;
        color: var(--color-text);
        margin: 48px 0 16px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
        scroll-margin-top: 90px;
    }
    .term-content :global(h2:first-child) {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
    }
    .term-content :global(p) {
        font-size: 16px;
        line-height: 1.8;
        color: var(--color-text-muted);
        margin-bottom: 20px;
    }
    .term-content :global(ul), .term-content :global(ol) {
        padding-left: 24px;
        margin-bottom: 20px;
        color: var(--color-text-muted);
    }
    .term-content :global(li) {
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 8px;
    }
    .term-content :global(strong) { color: var(--color-text); }
    .term-content :global(a) {
        color: var(--gold);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .term-content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.88em;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 3px;
        padding: 1px 5px;
    }

    /* Related sidebar */
    .related-sidebar {
        position: sticky;
        top: 100px;
    }
    .related-heading {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: 16px;
    }
    .related-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }
    .related-link {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding: 12px 14px;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        text-decoration: none;
        transition: border-color 0.12s;
    }
    .related-link:hover { border-color: var(--gold); }
    .related-link strong { font-size: 13px; color: var(--color-text); }
    .related-abbr { font-family: var(--font-mono); font-size: 10px; color: var(--gold); }
    .related-def { font-size: 11px; color: var(--color-text-muted); line-height: 1.4; }
    .back-to-hub {
        font-size: 13px;
        color: var(--color-text-muted);
        text-decoration: none;
        display: block;
    }
    .back-to-hub:hover { color: var(--gold); }

    .term-featured-image-wrap {
        margin-top: 36px;
        background: var(--color-surface);
    }
    .term-featured-figure {
        margin: 0;
        border-radius: var(--radius-md, 8px);
        overflow: hidden;
        border: 1px solid var(--color-border);
        margin-bottom: -1px;
        line-height: 0;
    }
    .term-featured-img {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
    }
    @media (max-width: 900px) {
        .term-body {
            grid-template-columns: 1fr;
            gap: 48px;
        }
        .related-sidebar { position: static; }
    }
    @media (max-width: 600px) {
        .term-featured-figure {
            border-radius: 0;
            border-left: none;
            border-right: none;
        }
    }
</style>
